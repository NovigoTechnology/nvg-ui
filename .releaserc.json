{
  "branches": ["main", "master"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/npm",
      {
        "npmPublish": false
      }
    ],
    "./scripts/prepare-git-release.mjs",
    [
      "@semantic-release/github",
      {
        "assets": [
          { "path": "dist/nvg-ui.es.js", "label": "ES Module" },
          { "path": "dist/nvg-ui.umd.js", "label": "UMD Module" },
          { "path": "dist/index.d.ts", "label": "Type declarations" }
        ]
      }
    ]
  ]
}
